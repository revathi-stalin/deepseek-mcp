# DeepSeek API Configuration
# Get your API key from https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-api-key-here

# Model Inference API Configuration (for Render deployment)
BASE_MODEL_PATH=deepseek-ai/DeepSeek-V3
LORA_PATH=/app/models/lora
PORT=8000
PYTHONUNBUFFERED=1

# Optional: HuggingFace Authentication
HUGGINGFACE_TOKEN=your_token_here

# Optional: Weights & Biases for training monitoring
WANDB_API_KEY=your_wandb_key_here
WANDB_PROJECT=deepseek-finetuning
